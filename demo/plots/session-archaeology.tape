# ── launch ──────────────────────────────────────────────────────
Hide
Type@0ms "rm -rf '/home/scoutme/altworkspace/milk/demo/.workdirs/session-arch-root' && cp -r '/home/scoutme/altworkspace/milk/demo/.workdirs/session-arch-seed' '/home/scoutme/altworkspace/milk/demo/.workdirs/session-arch-root' && cd '/home/scoutme/altworkspace/milk/demo/.workdirs/session-arch' && MILK_CONFIG_ROOT='/home/scoutme/altworkspace/milk/demo/.workdirs/session-arch-root' '/home/scoutme/.local/bin/milk' --new"
Enter
Sleep 2.8s
Show

# ── startup: the git panel opens on the seeded history — SHW-2049 is already on screen ──
Type "/panel git"
Enter
# wait: SHW-2049
Sleep 0.4s
Sleep 0.6s
# pause between beats — room to read the result
Sleep 1.5s

# ── read: read the issue and quote it — the model works from real context ──
