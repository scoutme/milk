Sleep 0.4s
# until gone: role:ESCALATION
Sleep 23.2s
Sleep 0.6s
# pause between beats — room to read the result
Sleep 1.5s

# ── implement: back on the primary: the fix lands and proves itself ──
Type "/primary"
Enter
# wait: pinned to mimo-local
Sleep 0.4s
Type "Implement the fix for SHW-2049 in blink.go — keep it minimal — then run go run . and reply with its output verbatim."
Enter
# wait: role:PRIMARY
Sleep 0.8s
# until gone: role:PRIMARY
Sleep 62.2s
