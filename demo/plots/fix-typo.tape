# GENERATED by `task showcase:record` from milk-plot-fix-typo — edit the manifest, not this file.
# Beats and sleeps are calibrated against a live run; regenerate after changing the manifest.
Output docs/assets/showcase-fix-typo.mp4

Set Shell "bash"
Set Width 1900
Set Height 1120
Set FontSize 14
Set Theme "Dracula"
Set TypingSpeed 60ms
Set PlaybackSpeed 0.9

# ── launch ──────────────────────────────────────────────────────
Hide
Type@0ms "rm -rf '/home/scoutme/altworkspace/milk/demo/.workdirs/fix-typo-root' && cp -r '/home/scoutme/altworkspace/milk/demo/.workdirs/fix-typo-seed' '/home/scoutme/altworkspace/milk/demo/.workdirs/fix-typo-root' && cd '/home/scoutme/altworkspace/milk/demo/.workdirs/fix-typo' && MILK_CONFIG_ROOT='/home/scoutme/altworkspace/milk/demo/.workdirs/fix-typo-root' '/home/scoutme/.local/bin/milk' --new"
Enter
Sleep 2.8s
Show

# ── startup: open the project and git panels — the seeded repo is real (files, branch, commit) ──
Type "/panel project"
Enter
# wait: main.go
Sleep 0.4s
Type "/panel git"
Enter
# wait: ⎇
Sleep 0.4s
Sleep 0.6s
# pause between beats — room to read the result
Sleep 1.5s

# ── fix: the requirement vs. the code — the model finds the off-by-one and proves it ──
Type "The README acceptance fails: go run . does not print the required output. Fix main.go, then run go run . and go test -v ./... and reply with both outputs verbatim."
Enter
# wait: role:PRIMARY
Sleep 6.1s
# wait: count=10
Sleep 61.9s
# wait: PASS
Sleep 0.6s
# pause between beats — room to read the result
Sleep 1.5s

# ── task: the ship-it task lands in the tasks panel (content event, #347) ──
# until gone: role:PRIMARY
Sleep 1.9s
Type `Create a task titled "SHIPIT counter fix" and reply: done`
Enter
# wait: role:PRIMARY
Sleep 0.8s
# until gone: role:PRIMARY
Sleep 19.0s
Type "/tasks"
Enter
# wait: pending     SHIPIT
Sleep 0.4s
Sleep 0.6s
# pause between beats — room to read the result
Sleep 1.5s

# ── learn: /learn records what happened — memory panel opens on the new percept ──
Type "/learn counter counts to 10 — fixed the off-by-one in Count (showcase plot A)"
Enter
# wait: [milk] learned:
Sleep 0.8s
# wait: CONTEXT BRICKS
Sleep 4.9s
Sleep 0.6s

# hold the final view — the last screen stays a few seconds before the loop
Sleep 5s
